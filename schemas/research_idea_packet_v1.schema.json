{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joshgutierrez56.github.io/pure-news-intelligence-demo/schemas/research_idea_packet_v1.schema.json",
  "title": "Pure News Intelligence Research Idea Packet V1",
  "description": "Strict point-in-time contract for an evidence-grounded AI Research Idea and an optional illustrative trade hypothesis. The packet contains no ex-post outcome, price target, position size, leverage, allocation, or personalized-advice field.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packet_version",
    "packet_id",
    "packet_hash",
    "packet_status",
    "change_id",
    "issuer",
    "ticker",
    "filing_date",
    "formation_timestamp",
    "section",
    "source_url",
    "input_lineage",
    "evidence",
    "frozen_classification",
    "system_interpretation",
    "economic_mechanisms",
    "affected_entities",
    "research_hypotheses",
    "analyst_questions",
    "scenario_analysis",
    "illustrative_trade_hypothesis",
    "skeptical_review",
    "confidence",
    "analyst_disposition",
    "generation_metadata",
    "audit_metadata",
    "disclaimer"
  ],
  "properties": {
    "packet_version": {
      "const": "1.0"
    },
    "packet_id": {
      "$ref": "#/$defs/identifier"
    },
    "packet_hash": {
      "description": "Lowercase SHA-256 of UTF-8 JSON serialized with keys sorted, separators (',' and ':'), and ensure_ascii=false after replacing packet_hash with 64 zeroes. Stage-one artifacts retain the 64-zero placeholder until the deterministic wrapper computes this value.",
      "$ref": "#/$defs/sha256"
    },
    "packet_status": {
      "$ref": "#/$defs/packetStatus"
    },
    "change_id": {
      "$ref": "#/$defs/identifier"
    },
    "issuer": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "ticker": {
      "type": "string",
      "minLength": 1,
      "maxLength": 24,
      "pattern": "^[A-Z0-9][A-Z0-9.\\-]*$"
    },
    "filing_date": {
      "type": "string",
      "format": "date"
    },
    "formation_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "section": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "source_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "input_lineage": {
      "$ref": "#/$defs/inputLineage"
    },
    "evidence": {
      "$ref": "#/$defs/evidence"
    },
    "frozen_classification": {
      "$ref": "#/$defs/frozenClassification"
    },
    "system_interpretation": {
      "$ref": "#/$defs/systemInterpretation"
    },
    "economic_mechanisms": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/economicMechanism"
      }
    },
    "affected_entities": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/affectedEntity"
      }
    },
    "research_hypotheses": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/researchHypothesis"
      }
    },
    "analyst_questions": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/analystQuestion"
      }
    },
    "scenario_analysis": {
      "$ref": "#/$defs/scenarioAnalysis"
    },
    "illustrative_trade_hypothesis": {
      "$ref": "#/$defs/tradeHypothesis"
    },
    "skeptical_review": {
      "$ref": "#/$defs/skepticalReview"
    },
    "confidence": {
      "$ref": "#/$defs/confidence"
    },
    "analyst_disposition": {
      "$ref": "#/$defs/analystDisposition"
    },
    "generation_metadata": {
      "$ref": "#/$defs/generationMetadata"
    },
    "audit_metadata": {
      "$ref": "#/$defs/auditMetadata"
    },
    "disclaimer": {
      "const": "AI-generated research hypothesis based on the cited evidence. It is not a fact, personalized investment advice, or a validated trading signal. Analyst review is required."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "packet_status": {
            "enum": [
              "DRAFT_PENDING_SKEPTIC",
              "PUBLISHABLE"
            ]
          }
        },
        "required": [
          "packet_status"
        ]
      },
      "then": {
        "properties": {
          "economic_mechanisms": {
            "minItems": 1
          },
          "research_hypotheses": {
            "minItems": 2
          },
          "analyst_questions": {
            "minItems": 5
          },
          "scenario_analysis": {
            "properties": {
              "bull": {
                "properties": {
                  "conditions": {
                    "minItems": 1
                  },
                  "implications": {
                    "minItems": 1
                  }
                }
              },
              "base": {
                "properties": {
                  "conditions": {
                    "minItems": 1
                  },
                  "implications": {
                    "minItems": 1
                  }
                }
              },
              "bear": {
                "properties": {
                  "conditions": {
                    "minItems": 1
                  },
                  "implications": {
                    "minItems": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "packet_status": {
            "const": "PUBLISHABLE"
          }
        },
        "required": [
          "packet_status"
        ]
      },
      "then": {
        "properties": {
          "skeptical_review": {
            "properties": {
              "critical_grounding_defect": {
                "const": false
              },
              "final_review_status": {
                "enum": [
                  "PASS",
                  "PASS_WITH_EDITS"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "packet_status": {
            "enum": [
              "HOLD_UNSUPPORTED",
              "HOLD_AMBIGUOUS",
              "HOLD_INSUFFICIENT_EVIDENCE",
              "REJECTED_BY_SKEPTIC"
            ]
          }
        },
        "required": [
          "packet_status"
        ]
      },
      "then": {
        "properties": {
          "illustrative_trade_hypothesis": {
            "properties": {
              "trade_readiness": {
                "const": "NOT_READY"
              },
              "no_position_size_generated": {
                "const": true
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "shortString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "identifier": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\-]*$"
    },
    "evidenceId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^(?:EV-|evidence-v1:)[A-Za-z0-9][A-Za-z0-9._:\\-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "nullableSha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableTimestamp": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableUri": {
      "oneOf": [
        {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        {
          "type": "null"
        }
      ]
    },
    "confidenceScore": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "stringList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "evidenceIdList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/evidenceId"
      }
    },
    "packetStatus": {
      "type": "string",
      "enum": [
        "DRAFT_PENDING_SKEPTIC",
        "PUBLISHABLE",
        "HOLD_UNSUPPORTED",
        "HOLD_AMBIGUOUS",
        "HOLD_INSUFFICIENT_EVIDENCE",
        "REJECTED_BY_SKEPTIC"
      ]
    },
    "inputLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_contract_version",
        "source_record_sha256",
        "allowed_input_fields_used",
        "formation_time_enforced",
        "future_information_excluded",
        "post_filing_news_excluded",
        "ex_post_outcomes_excluded",
        "cloud_calls_made"
      ],
      "properties": {
        "input_contract_version": {
          "const": "research_idea_input_v1"
        },
        "source_record_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "allowed_input_fields_used": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "issuer",
              "ticker",
              "filing_date",
              "formation_timestamp",
              "section",
              "prior_filing_excerpt",
              "current_filing_excerpt",
              "added_language",
              "removed_language",
              "frozen_classification",
              "related_prior_8k",
              "related_prior_news",
              "frozen_company_metadata",
              "source_urls_and_identifiers",
              "current_product_reason_code",
              "evidence_offsets"
            ]
          }
        },
        "formation_time_enforced": {
          "const": true
        },
        "future_information_excluded": {
          "const": true
        },
        "post_filing_news_excluded": {
          "const": true
        },
        "ex_post_outcomes_excluded": {
          "const": true
        },
        "cloud_calls_made": {
          "const": false
        }
      }
    },
    "sourceRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "source_url",
        "start",
        "end",
        "offset_unit",
        "verified"
      ],
      "properties": {
        "document_id": {
          "$ref": "#/$defs/identifier"
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "offset_unit": {
          "const": "unicode_code_points"
        },
        "verified": {
          "const": true
        }
      }
    },
    "nullableSourceRange": {
      "oneOf": [
        {
          "$ref": "#/$defs/sourceRange"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidenceIdMap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prior_excerpt",
        "current_excerpt",
        "added_text",
        "removed_text"
      ],
      "properties": {
        "prior_excerpt": {
          "$ref": "#/$defs/evidenceId"
        },
        "current_excerpt": {
          "$ref": "#/$defs/evidenceId"
        },
        "added_text": {
          "$ref": "#/$defs/evidenceId"
        },
        "removed_text": {
          "$ref": "#/$defs/evidenceId"
        }
      }
    },
    "evidenceOffsets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prior",
        "current"
      ],
      "properties": {
        "prior": {
          "$ref": "#/$defs/simpleOffsetRange"
        },
        "current": {
          "$ref": "#/$defs/simpleOffsetRange"
        }
      }
    },
    "simpleOffsetRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "relatedPrior8k": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "accession_number",
        "url",
        "acceptance_timestamp",
        "information_date",
        "item_codes",
        "match_score",
        "matched_terms",
        "primary_category",
        "similarity"
      ],
      "properties": {
        "evidence_id": {
          "$ref": "#/$defs/evidenceId"
        },
        "accession_number": {
          "$ref": "#/$defs/identifier"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "acceptance_timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "information_date": {
          "type": "string",
          "format": "date"
        },
        "item_codes": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "match_score": {
          "type": "number",
          "minimum": 0
        },
        "matched_terms": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/shortString"
          }
        },
        "primary_category": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "similarity": {
          "$ref": "#/$defs/confidenceScore"
        }
      }
    },
    "relatedPriorNews": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "story_chain_id",
        "provider_host",
        "publication_timestamp",
        "headline",
        "match_score",
        "matched_terms",
        "similarity"
      ],
      "properties": {
        "evidence_id": {
          "$ref": "#/$defs/evidenceId"
        },
        "story_chain_id": {
          "$ref": "#/$defs/identifier"
        },
        "provider_host": {
          "$ref": "#/$defs/shortString"
        },
        "publication_timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "headline": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "match_score": {
          "type": "number",
          "minimum": 0
        },
        "matched_terms": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/shortString"
          }
        },
        "similarity": {
          "$ref": "#/$defs/confidenceScore"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prior_filing_id",
        "current_filing_id",
        "prior_source_url",
        "current_source_url",
        "prior_excerpt",
        "current_excerpt",
        "added_text",
        "removed_text",
        "evidence_ids",
        "evidence_offsets",
        "evidence_offsets_verified",
        "related_prior_8k",
        "related_prior_news"
      ],
      "properties": {
        "prior_filing_id": {
          "$ref": "#/$defs/identifier"
        },
        "current_filing_id": {
          "$ref": "#/$defs/identifier"
        },
        "prior_source_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "current_source_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "prior_excerpt": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "current_excerpt": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "added_text": {
          "type": "string",
          "maxLength": 12000
        },
        "removed_text": {
          "type": "string",
          "maxLength": 12000
        },
        "evidence_ids": {
          "$ref": "#/$defs/evidenceIdMap"
        },
        "evidence_offsets": {
          "$ref": "#/$defs/evidenceOffsets"
        },
        "evidence_offsets_verified": {
          "const": true
        },
        "related_prior_8k": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relatedPrior8k"
          }
        },
        "related_prior_news": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relatedPriorNews"
          }
        }
      }
    },
    "frozenClassification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "direction",
        "materiality",
        "novelty",
        "confidence",
        "classification_method",
        "novelty_method",
        "novelty_is_causal_claim"
      ],
      "properties": {
        "category": {
          "$ref": "#/$defs/shortString"
        },
        "direction": {
          "type": "string",
          "enum": [
            "positive",
            "negative",
            "mixed",
            "ambiguous"
          ]
        },
        "materiality": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "novelty": {
          "$ref": "#/$defs/shortString"
        },
        "confidence": {
          "$ref": "#/$defs/confidenceScore"
        },
        "classification_method": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "novelty_method": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "novelty_is_causal_claim": {
          "const": false
        }
      }
    },
    "evidenceFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact_id",
        "statement",
        "fact_type",
        "evidence_ids"
      ],
      "properties": {
        "fact_id": {
          "$ref": "#/$defs/identifier"
        },
        "statement": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "fact_type": {
          "type": "string",
          "enum": [
            "filing_text",
            "filing_metadata",
            "prior_disclosure",
            "frozen_classification",
            "frozen_company_metadata"
          ]
        },
        "evidence_ids": {
          "$ref": "#/$defs/evidenceIdList"
        }
      }
    },
    "inference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inference_id",
        "statement",
        "inference_type",
        "evidence_ids",
        "confidence",
        "caveat"
      ],
      "properties": {
        "inference_id": {
          "$ref": "#/$defs/identifier"
        },
        "statement": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "inference_type": {
          "type": "string",
          "enum": [
            "economic_mechanism",
            "affected_entity",
            "research_implication",
            "scenario",
            "instrument_fit"
          ]
        },
        "evidence_ids": {
          "$ref": "#/$defs/evidenceIdList"
        },
        "confidence": {
          "$ref": "#/$defs/confidenceScore"
        },
        "caveat": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uncertainty_id",
        "uncertainty",
        "why_it_matters",
        "data_needed"
      ],
      "properties": {
        "uncertainty_id": {
          "$ref": "#/$defs/identifier"
        },
        "uncertainty": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "why_it_matters": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "data_needed": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "systemInterpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plain_language_change",
        "evidence_facts",
        "inferences",
        "uncertainties"
      ],
      "properties": {
        "plain_language_change": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "evidence_facts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidenceFact"
          }
        },
        "inferences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inference"
          }
        },
        "uncertainties": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/uncertainty"
          }
        }
      }
    },
    "economicMechanism": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mechanism_id",
        "mechanism",
        "affected_financial_driver",
        "causal_chain",
        "supporting_evidence_ids",
        "counterargument",
        "mechanism_confidence"
      ],
      "properties": {
        "mechanism_id": {
          "$ref": "#/$defs/identifier"
        },
        "mechanism": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "affected_financial_driver": {
          "$ref": "#/$defs/shortString"
        },
        "causal_chain": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "supporting_evidence_ids": {
          "$ref": "#/$defs/evidenceIdList"
        },
        "counterargument": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "mechanism_confidence": {
          "$ref": "#/$defs/confidenceScore"
        }
      }
    },
    "affectedEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_id",
        "entity_or_group",
        "relationship",
        "possible_effect",
        "reason",
        "evidence_ids",
        "confidence"
      ],
      "properties": {
        "entity_id": {
          "$ref": "#/$defs/identifier"
        },
        "entity_or_group": {
          "$ref": "#/$defs/shortString"
        },
        "relationship": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "possible_effect": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "reason": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "evidence_ids": {
          "$ref": "#/$defs/evidenceIdList"
        },
        "confidence": {
          "$ref": "#/$defs/confidenceScore"
        }
      }
    },
    "researchHypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hypothesis_id",
        "title",
        "hypothesis",
        "expected_direction",
        "time_horizon",
        "unit_of_analysis",
        "required_data",
        "confirmation_conditions",
        "falsification_conditions",
        "confounders",
        "evidence_ids",
        "novelty_assessment",
        "testability_score",
        "grounding_score"
      ],
