    "tradeHypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "status",
        "candidate_view",
        "preferred_instrument_class_to_investigate",
        "instrument_rationale",
        "expected_horizon",
        "entry_or_confirmation_conditions",
        "invalidation_conditions",
        "key_risks",
        "market_data_required_before_action",
        "liquidity_and_cost_checks",
        "evidence_ids",
        "trade_readiness",
        "trade_readiness_reason",
        "current_market_data_used",
        "illustrative_only",
        "analyst_review_required",
        "no_position_size_generated"
      ],
      "properties": {
        "label": {
          "const": "Illustrative Trade Hypothesis — Analyst Review Required"
        },
        "status": {
          "type": "string",
          "enum": [
            "RESEARCH_ONLY",
            "NO_ACTIONABLE_VIEW",
            "INSUFFICIENT_EVIDENCE",
            "WITHHELD_BY_SKEPTIC"
          ]
        },
        "candidate_view": {
          "type": "string",
          "enum": [
            "bullish bias",
            "bearish bias",
            "credit-positive",
            "credit-negative",
            "volatility-up",
            "volatility-down",
            "relative-value monitor",
            "no actionable view",
            "insufficient evidence"
          ]
        },
        "preferred_instrument_class_to_investigate": {
          "type": "string",
          "enum": [
            "common equity",
            "corporate bonds",
            "CDS, if data access exists",
            "listed options",
            "sector ETF",
            "peer basket",
            "no instrument identified"
          ]
        },
        "instrument_rationale": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "expected_horizon": {
          "$ref": "#/$defs/shortString"
        },
        "entry_or_confirmation_conditions": {
          "$ref": "#/$defs/stringList"
        },
        "invalidation_conditions": {
          "$ref": "#/$defs/stringList"
        },
        "key_risks": {
          "$ref": "#/$defs/stringList"
        },
        "market_data_required_before_action": {
          "$ref": "#/$defs/stringList"
        },
        "liquidity_and_cost_checks": {
          "$ref": "#/$defs/stringList"
        },
        "evidence_ids": {
          "$ref": "#/$defs/evidenceIdList"
        },
        "trade_readiness": {
          "type": "string",
          "enum": [
            "NOT_READY",
            "READY_FOR_ANALYST_RESEARCH"
          ]
        },
        "trade_readiness_reason": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "current_market_data_used": {
          "const": false
        },
        "illustrative_only": {
          "const": true
        },
        "analyst_review_required": {
          "const": true
        },
        "no_position_size_generated": {
          "const": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "trade_readiness": {
                "const": "READY_FOR_ANALYST_RESEARCH"
              }
            },
            "required": [
              "trade_readiness"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "const": "RESEARCH_ONLY"
              },
              "entry_or_confirmation_conditions": {
                "minItems": 1
              },
              "invalidation_conditions": {
                "minItems": 1
              },
              "key_risks": {
                "minItems": 1
              },
              "market_data_required_before_action": {
                "minItems": 1
              },
              "liquidity_and_cost_checks": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
